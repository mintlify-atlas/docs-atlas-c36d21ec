    "agent.history: HistoricalEvent[]",
    "agent.lastResult: ExecutionResult | null",
    "agent.onAskUser: (question, options) => Promise<string>",
    "agent.pushObservation(content: string): void",
    "new PageAgentCore(config: PageAgentCoreConfig)",
    "new PageController(config: PageControllerConfig)",
    "tool(options: PageAgentTool): PageAgentTool",
